{
  "name": "fluxo-financial-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json && vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist",
    "cf:bootstrap": "node scripts/cloudflare-bootstrap.mjs",
    "cf:validate": "wrangler d1 list --help >/dev/null && wrangler d1 create --help >/dev/null && wrangler d1 migrations apply --help >/dev/null && wrangler pages project list --help >/dev/null && wrangler pages project create --help >/dev/null && wrangler pages secret bulk --help >/dev/null && wrangler pages deploy --help >/dev/null",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to=.wrangler/local",
    "db:validate": "wrangler d1 migrations apply DB --local --persist-to=.wrangler/ci",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
