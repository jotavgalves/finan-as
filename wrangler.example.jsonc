{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "finan-as",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finan-as-prod",
      "database_id": "<PRODUCTION_D1_UUID>"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "finan-as-preview",
          "database_id": "<PREVIEW_D1_UUID>"
        }
      ]
    }
  }
}
